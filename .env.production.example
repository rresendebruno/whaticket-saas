# =============================================================================
# WhaTicket Community - Configuração de PRODUÇÃO
# =============================================================================
# Copie este arquivo para .env na VPS e preencha as senhas/tokens reais.
# NUNCA commite o .env com dados reais no repositório.
#
# Para gerar JWT secrets seguros:
#   openssl rand -hex 32
#
# Domínios usados:
#   Frontend : https://chat.cloudconnectivity.com.br
#   Backend  : https://api.cloudconnectivity.com.br
#
# Antes de fazer deploy, garanta que os dois registros DNS apontam
# para o IP da sua VPS.
# =============================================================================

# -----------------------------------------------------------------------------
# MYSQL / MARIADB
# -----------------------------------------------------------------------------
MYSQL_ENGINE=mariadb
MYSQL_VERSION=10.6
MYSQL_DATABASE=whaticket
MYSQL_ROOT_PASSWORD=TROQUE_POR_SENHA_FORTE_AQUI
TZ=America/Sao_Paulo

# -----------------------------------------------------------------------------
# BACKEND
# -----------------------------------------------------------------------------
BACKEND_URL=https://api.cloudconnectivity.com.br
PROXY_PORT=443

FRONTEND_URL=https://chat.cloudconnectivity.com.br

# OBRIGATÓRIO: gere com: openssl rand -hex 32
JWT_SECRET=GERE_COM_OPENSSL_RAND_HEX_32
# OBRIGATÓRIO: gere com: openssl rand -hex 32  (diferente do JWT_SECRET)
JWT_REFRESH_SECRET=GERE_COM_OUTRO_OPENSSL_RAND_HEX_32

# WhatsApp provider
WHATSAPP_PROVIDER=zapi

# Z-API credenciais
ZAPI_INSTANCE_ID=COLE_SEU_INSTANCE_ID_AQUI
ZAPI_TOKEN=COLE_SEU_TOKEN_AQUI
ZAPI_CLIENT_TOKEN=COLE_SEU_CLIENT_TOKEN_AQUI

# URL pública que a Z-API usará para enviar webhooks ao backend
# (deve ser a URL do backend acessível pela internet)
ZAPI_PUBLIC_URL=https://api.cloudconnectivity.com.br

# -----------------------------------------------------------------------------
# FRONTEND (nginx)
# -----------------------------------------------------------------------------
FRONTEND_SERVER_NAME=chat.cloudconnectivity.com.br

# Deixe vazio - o Traefik roteia diretamente para o container do backend
BACKEND_SERVER_NAME=
